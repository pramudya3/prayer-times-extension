{
  "manifest_version": 3,
  "name": "Prayer Times",
  "version": "1.0.2",
  "description": "Accurate prayer times with automatic location detection.",
  "permissions": ["notifications", "storage", "geolocation", "alarms", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://api.aladhan.com/*",
    "https://api.bigdatacloud.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
